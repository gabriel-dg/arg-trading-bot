# Checklist of process environment variables for live mode. Paper mode and the lab
# need none of these. The bot does not load this file: export the variables in your
# shell, or set them with $env: on PowerShell. Never commit a file that holds secrets.

# Live trading gate (also asks for a typed confirmation). Leave empty for paper mode.
LIVE_TRADING=

# IOL adapter credentials (only for `argbot live`)
IOL_USERNAME=
IOL_PASSWORD=
# Live mode always uses IOL's production API; there is no sandbox mode.
